// Client download list for the notrail rocket model.
// The .mdl is byte-identical to stock w_rocket.mdl except the emission
// attachment is renamed "trail" -> "tdb", so the client's
// C_TFBaseRocket::CreateTrails() LookupAttachment("trail") fails and the
// engine trail is never created. Attach custom trails to "tdb".
models/custom/dodgeball/w_rocket_notrail/w_rocket_notrail.mdl
models/custom/dodgeball/w_rocket_notrail/w_rocket_notrail.vvd
models/custom/dodgeball/w_rocket_notrail/w_rocket_notrail.phy
models/custom/dodgeball/w_rocket_notrail/w_rocket_notrail.dx80.vtx
models/custom/dodgeball/w_rocket_notrail/w_rocket_notrail.dx90.vtx
models/custom/dodgeball/w_rocket_notrail/w_rocket_notrail.sw.vtx
